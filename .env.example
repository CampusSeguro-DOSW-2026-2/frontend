# API Gateway: único punto de entrada del frontend (MS01, MS03, etc.), sin /api/v1.
# En local es http://localhost:8080 (docker-compose.gw.yml de MS03 con la imagen :integracion).
VITE_API_URL=http://localhost:8080
# Alertas reales de MS03 en la pantalla de inicio (sin esto usa datos locales de demostración)
VITE_USE_MS03=true
# Segundos de espera para reenviar el código de recuperación (0 lo desactiva)
# VITE_RECOVERY_RESEND_SECONDS=60
