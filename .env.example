# URL base de MS03 y activación de la integración
VITE_MS03_URL=http://localhost:8080
VITE_USE_MS03=true

# URL para MS01 (registro, sesión, perfil, usuarios y roles), sin /api/v1. Debería ser el API Gateway,
# pero aún no está implementado: mientras tanto se apunta directo a MS01 (puerto 8081). El 8080 es MS03.
VITE_API_URL=http://localhost:8081
# Segundos de espera para reenviar el código de recuperación (0 lo desactiva)
# VITE_RECOVERY_RESEND_SECONDS=60
